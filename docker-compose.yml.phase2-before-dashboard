services:

  api:
    build:
      context: ./apps/api
    container_name: xaasgrid-api
    ports:
      - "4000:4000"
    env_file:
      - .env
    environment:
      PORT: 4000
      DATABASE_URL: postgresql://eaas_user:EAAS_Strong_2026!@postgres:5432/eaas_db
      REDIS_URL: redis://redis:6379
    depends_on:
      postgres:
        condition: service_started
      redis:
        condition: service_started


  postgres:
    image: postgres:15
    container_name: xaasgrid-postgres
    environment:
      POSTGRES_USER: eaas_user
      POSTGRES_PASSWORD: EAAS_Strong_2026!
      POSTGRES_DB: eaas_db
    volumes:
      - infrastructure_postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"


  redis:
    image: redis:7
    container_name: xaasgrid-redis
    ports:
      - "6379:6379"


volumes:

  infrastructure_postgres_data:
    external: true
