
generator client {
 provider="prisma-client-js"
}


datasource db {
 provider="postgresql"
 url=env("DATABASE_URL")
}


model User {

 id Int @id @default(autoincrement())

 email String @unique

 passwordHash String

 role String @default("user")

 createdAt DateTime @default(now())

}


model Company {

 id Int @id @default(autoincrement())

 name String

 createdAt DateTime @default(now())

}

